{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://political-pathology-workbench.local/schemas/search-log.schema.json",
  "title": "Search Log",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["searchId", "date", "query", "database", "purpose"],
    "properties": {
      "searchId": { "type": "string" },
      "date": { "type": "string" },
      "query": { "type": "string" },
      "database": { "type": "string" },
      "environment": { "type": "string" },
      "purpose": { "$ref": "controlled-vocab.schema.json#/$defs/searchPurpose" },
      "evidencePolarity": { "$ref": "controlled-vocab.schema.json#/$defs/evidencePolarity" },
      "argumentRole": { "$ref": "controlled-vocab.schema.json#/$defs/argumentRole" },
      "completionStatus": {
        "type": "string",
        "enum": ["planned", "in-progress", "completed", "abandoned"]
      },
      "inclusionCriteria": {
        "type": "array",
        "items": { "type": "string" }
      },
      "exclusionCriteria": {
        "type": "array",
        "items": { "type": "string" }
      },
      "resultsCount": { "type": "integer", "minimum": 0 },
      "screenedCount": { "type": "integer", "minimum": 0 },
      "includedCount": { "type": "integer", "minimum": 0 },
      "includedSourceIds": {
        "type": "array",
        "items": { "type": "string" }
      },
      "includedPassageIds": {
        "type": "array",
        "items": { "type": "string" }
      },
      "notes": { "type": "string" }
    }
  }
}
