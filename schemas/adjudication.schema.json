{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://political-pathology-workbench.local/schemas/adjudication.schema.json",
  "title": "Score Adjudications",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "adjudicationId",
      "codingRoundId",
      "unitId",
      "variableId",
      "inputCoderScoreIds",
      "adjudicatedValue",
      "valueSemantics",
      "decisionState",
      "disagreementCategories",
      "inputRange",
      "absoluteDisagreement",
      "adjudicatorId",
      "timestamp",
      "rationale"
    ],
    "properties": {
      "adjudicationId": { "type": "string" },
      "codingRoundId": { "type": "string" },
      "unitId": { "type": "string" },
      "variableId": { "type": "string" },
      "inputCoderScoreIds": {
        "type": "array",
        "items": { "type": "string" }
      },
      "adjudicatedValue": {
        "type": ["number", "null"],
        "minimum": 0,
        "maximum": 5
      },
      "valueSemantics": {
        "type": "string",
        "enum": ["construct-magnitude", "unknown"]
      },
      "unknownReason": { "type": "string" },
      "decisionState": {
        "type": "string",
        "enum": ["unresolved", "adjudicated", "excluded"]
      },
      "disagreementCategories": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": ["evidence-selection", "construct-boundary", "temporal-scope", "source-interpretation", "scale-boundary", "missing-evidence", "codebook-ambiguity", "other"]
        },
        "minItems": 1
      },
      "inputRange": {
        "type": "object",
        "required": ["min", "max"],
        "properties": {
          "min": { "type": ["number", "null"], "minimum": 0, "maximum": 5 },
          "max": { "type": ["number", "null"], "minimum": 0, "maximum": 5 }
        }
      },
      "absoluteDisagreement": {
        "type": ["number", "null"],
        "minimum": 0,
        "maximum": 5
      },
      "selfAdjudicationCaveat": { "type": "string" },
      "definitionRefs": {
        "type": "array",
        "items": { "type": "string" }
      },
      "confidence": {
        "type": "object",
        "required": ["value", "label", "rationale"],
        "properties": {
          "value": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "label": { "type": "string" },
          "rationale": { "type": "string" },
          "uncertaintyFactors": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "packetRefs": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["packetId", "packetHash"],
          "properties": {
            "packetId": { "type": "string" },
            "packetHash": { "type": "string" }
          }
        }
      },
      "evidenceRefs": {
        "type": "array",
        "items": { "type": "string" }
      },
      "adjudicatorId": { "type": "string" },
      "timestamp": { "type": "string" },
      "rationale": { "type": "string" }
    }
  }
}
